+
+    private boolean isDeferredSqliteCommitBusy(Throwable failure) {
+        // SQLite leaves the transaction active when COMMIT returns SQLITE_BUSY.
+        // Xerial's commit() also starts the next transaction: BEGIN IMMEDIATE/EXCLUSIVE
+        // can fail AFTER a successful commit, so only its lock-free DEFERRED path is safe.
+        // Wrappers and other drivers retain the conservative uncertain-outcome fence.
+        return connection instanceof SQLiteConnection sqlite
+                && sqlite.getCurrentTransactionMode() == SQLiteConfig.TransactionMode.DEFERRED
+                && sqlite.getConnectionConfig().getTransactionMode() == SQLiteConfig.TransactionMode.DEFERRED
+                && failure instanceof SQLiteException error
+                && error.getResultCode() == SQLiteErrorCode.SQLITE_BUSY;
+    }
 }
