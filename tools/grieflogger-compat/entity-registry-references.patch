+package com.daqem.grieflogger.database.schema;
+
+import com.daqem.grieflogger.database.Database;
+import java.sql.*;
+import java.util.*;
+
+/** The historical type ID belongs to the registry selected by the action. */
+public final class BlockSchema {
+    private static final List<String> BASE = List.of("time", "user", "level", "x", "y", "z", "type", "action");
+    private static final String MATERIAL = "CASE WHEN action = 3 THEN NULL ELSE type END";
+    private static final String ENTITY = "CASE WHEN action = 3 THEN type ELSE NULL END";
+    private static final String LEGACY_SQLITE = """
+            CREATE TABLE IF NOT EXISTS blocks (
+                time integer NOT NULL, user integer NOT NULL, level integer NOT NULL,
+                x integer NOT NULL, y integer NOT NULL, z integer NOT NULL,
+                type integer NOT NULL, action integer NOT NULL,
+                FOREIGN KEY(user) REFERENCES users(id),
+                FOREIGN KEY(level) REFERENCES levels(id),
+                FOREIGN KEY(type) REFERENCES materials(id)
+            );
+            """;
+    private static final String SQLITE = """
+            CREATE TABLE IF NOT EXISTS blocks (
+                time integer NOT NULL, user integer NOT NULL, level integer NOT NULL,
+                x integer NOT NULL, y integer NOT NULL, z integer NOT NULL,
+                type integer NOT NULL, action integer NOT NULL,
+                material_type integer GENERATED ALWAYS AS (%s) VIRTUAL,
+                entity_type integer GENERATED ALWAYS AS (%s) VIRTUAL,
+                FOREIGN KEY(user) REFERENCES users(id),
+                FOREIGN KEY(level) REFERENCES levels(id),
+                FOREIGN KEY(material_type) REFERENCES materials(id),
+                FOREIGN KEY(entity_type) REFERENCES entities(id)
+            );
+            """.formatted(MATERIAL, ENTITY);
+    private static final String MYSQL = """
+            CREATE TABLE IF NOT EXISTS blocks (
+                time bigint NOT NULL, user int NOT NULL, level int NOT NULL,
+                x int NOT NULL, y int NOT NULL, z int NOT NULL,
+                type int NOT NULL, action int NOT NULL,
+                material_type int GENERATED ALWAYS AS (%s) STORED,
+                entity_type int GENERATED ALWAYS AS (%s) STORED,
+                FOREIGN KEY(user) REFERENCES users(id),
+                FOREIGN KEY(level) REFERENCES levels(id),
+                CONSTRAINT blocks_material_type_fk FOREIGN KEY(material_type) REFERENCES materials(id),
+                CONSTRAINT blocks_entity_type_fk FOREIGN KEY(entity_type) REFERENCES entities(id)
+            ) ENGINE=InnoDB DEFAULT CHARACTER SET utf8mb4;
+            """.formatted(MATERIAL, ENTITY);
+
+    private BlockSchema() { }
+
+    public static void initialize(Database database, boolean mysql) {
+        database.initializeSchema(connection -> {
+            execute(connection, mysql ? MYSQL : SQLITE);
+            if (mysql) migrateMysql(connection); else migrateSqlite(connection);
+        });
+    }
+
+    private static void execute(Connection connection, String sql) throws SQLException {
+        try (var statement = connection.createStatement()) { statement.execute(sql); }
+    }
+
+    private static String normalize(String sql) {
+        return sql.toLowerCase(Locale.ROOT).replaceAll("[\\s;`\"()]", "").replace("ifnotexists", "");
+    }
+
+    private static void migrateSqlite(Connection connection) throws SQLException {
+        String sql;
+        try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT sql FROM sqlite_master WHERE type='table' AND name='blocks'")) {
+            if (!rows.next()) throw new SQLException("Missing blocks schema");
+            sql = rows.getString(1);
+        }
+        if (!normalize(sql).equals(normalize(SQLITE))) {
+            if (!normalize(sql).equals(normalize(LEGACY_SQLITE))) throw new SQLException("Unsupported blocks schema; review registry references before logging");
+            // Keep rowids and all original index/trigger definitions in the same transaction.
+            List<String> dependents = new ArrayList<>();
+            try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT sql FROM sqlite_master WHERE tbl_name='blocks' AND type IN ('index','trigger') AND sql IS NOT NULL ORDER BY type,name")) {
+                while (rows.next()) dependents.add(rows.getString(1));
+            }
+            try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT name FROM sqlite_master WHERE name='blocks_grieflogger_migration'")) {
+                if (rows.next()) throw new SQLException("Block schema migration table already exists; review unfinished schema work");
+            }
+            List<String> tables = new ArrayList<>();
+            try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT name FROM sqlite_master WHERE type='table' AND name<>'blocks'")) {
+                while (rows.next()) tables.add(rows.getString(1));
+            }
+            for (String table : tables) {
+                try (var statement = connection.createStatement(); var rows = statement.executeQuery("PRAGMA foreign_key_list(\"" + table.replace("\"", "\"\"") + "\")")) {
+                    while (rows.next()) if ("blocks".equals(rows.getString("table"))) throw new SQLException("External foreign key references blocks; review migration before logging");
+                }
+            }
+            execute(connection, SQLITE.replace("IF NOT EXISTS blocks", "blocks_grieflogger_migration"));
+            execute(connection, "INSERT INTO blocks_grieflogger_migration(rowid,time,user,level,x,y,z,type,action) SELECT rowid,time,user,level,x,y,z,type,action FROM blocks");
+            execute(connection, "DROP TABLE blocks");
+            execute(connection, "ALTER TABLE blocks_grieflogger_migration RENAME TO blocks");
+            for (String dependent : dependents) execute(connection, dependent);
+        }
+        try (var statement = connection.createStatement(); var rows = statement.executeQuery("PRAGMA foreign_key_check(blocks)")) {
+            if (rows.next()) throw new SQLException("Block history contains unresolved registry/actor/level references; logging admission disabled");
+        }
+    }
+
+    private record Column(String type, String nullable, String extra, String expression, String defaultValue) { }
+    private record Reference(String name, String target, String column) { }
+
+    private static void migrateMysql(Connection connection) throws SQLException {
+        try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT @@foreign_key_checks")) {
+            if (!rows.next() || rows.getInt(1) != 1) throw new SQLException("MySQL foreign key checks must be enabled for block schema initialization");
+        }
+        Map<String, Column> columns = new LinkedHashMap<>();
+        try (var statement = connection.createStatement(); var rows = statement.executeQuery("""
+                SELECT COLUMN_NAME,DATA_TYPE,IS_NULLABLE,EXTRA,GENERATION_EXPRESSION,COLUMN_DEFAULT
+                FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='blocks' ORDER BY ORDINAL_POSITION
+                """)) {
+            while (rows.next()) columns.put(rows.getString(1), new Column(rows.getString(2), rows.getString(3), rows.getString(4), rows.getString(5), rows.getString(6)));
+        }
+        List<String> names = new ArrayList<>(columns.keySet());
+        boolean legacy = names.equals(BASE);
+        List<String> expected = new ArrayList<>(BASE); expected.addAll(List.of("material_type", "entity_type"));
+        if (!legacy && !names.equals(expected)) throw new SQLException("Unsupported blocks columns; review registry references before logging");
+        for (String name : BASE) {
+            Column column = columns.get(name);
+            if (!column.type.equals(name.equals("time") ? "bigint" : "int") || !"NO".equals(column.nullable)
+                    || !"".equals(column.extra) || !"".equals(column.expression) || column.defaultValue != null)
+                throw new SQLException("Unsupported blocks column semantics: " + name);
+        }
+        Map<String, Reference> references = new HashMap<>();
+        try (var statement = connection.createStatement(); var rows = statement.executeQuery("""
+                SELECT k.COLUMN_NAME,k.CONSTRAINT_NAME,k.REFERENCED_TABLE_NAME,k.REFERENCED_COLUMN_NAME,
+                       k.REFERENCED_TABLE_SCHEMA,r.UPDATE_RULE,r.DELETE_RULE
+                FROM information_schema.key_column_usage k
+                JOIN information_schema.referential_constraints r ON r.CONSTRAINT_SCHEMA=k.CONSTRAINT_SCHEMA AND r.CONSTRAINT_NAME=k.CONSTRAINT_NAME
+                WHERE k.TABLE_SCHEMA=DATABASE() AND k.TABLE_NAME='blocks' AND k.REFERENCED_TABLE_NAME IS NOT NULL
+                """)) {
+            while (rows.next()) {
+                String field = rows.getString(1);
+                if (!connection.getCatalog().equals(rows.getString(5)) || !Set.of("RESTRICT", "NO ACTION").contains(rows.getString(6))
+                        || !Set.of("RESTRICT", "NO ACTION").contains(rows.getString(7))
+                        || references.put(field, new Reference(rows.getString(2), rows.getString(3), rows.getString(4))) != null)
+                    throw new SQLException("Unsupported blocks foreign key semantics");
+            }
+        }
+        Map<String, String> targets = legacy ? Map.of("user", "users", "level", "levels", "type", "materials")
+                : Map.of("user", "users", "level", "levels", "material_type", "materials", "entity_type", "entities");
+        if (!references.keySet().equals(targets.keySet())) throw new SQLException("Unsupported blocks foreign key structure");
+        for (var target : targets.entrySet()) {
+            Reference reference = references.get(target.getKey());
+            if (!reference.target.equals(target.getValue()) || !reference.column.equals("id")) throw new SQLException("Unsupported blocks registry foreign key");
+        }
+        if (legacy) {
+            String foreignKey = references.get("type").name.replace("`", "``");
+            // One atomic ALTER validates every existing row against its actual registry.
+            execute(connection, "ALTER TABLE blocks DROP FOREIGN KEY `" + foreignKey + "`, "
+                    + "ADD COLUMN material_type int GENERATED ALWAYS AS (" + MATERIAL + ") STORED, "
+                    + "ADD COLUMN entity_type int GENERATED ALWAYS AS (" + ENTITY + ") STORED, "
+                    + "ADD CONSTRAINT blocks_material_type_fk FOREIGN KEY(material_type) REFERENCES materials(id), "
+                    + "ADD CONSTRAINT blocks_entity_type_fk FOREIGN KEY(entity_type) REFERENCES entities(id)");
+        } else {
+            for (var generated : Map.of("material_type", MATERIAL, "entity_type", ENTITY).entrySet()) {
+                Column column = columns.get(generated.getKey());
+                if (!"int".equals(column.type) || !"YES".equals(column.nullable) || !"STORED GENERATED".equals(column.extra)
+                        || column.defaultValue != null || !normalize(column.expression).equals(normalize(generated.getValue())))
+                    throw new SQLException("Unsupported generated block registry reference: " + generated.getKey());
+            }
+        }
+    }
+}
