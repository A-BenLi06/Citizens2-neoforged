+    private static void ensureMysqlCommandCapacity(Connection connection) throws SQLException {
+        String type, charset, collation, nullable, defaultValue, extra, comment;
+        try (var query = connection.prepareStatement("""
+                SELECT DATA_TYPE, CHARACTER_SET_NAME, COLLATION_NAME, IS_NULLABLE,
+                       COLUMN_DEFAULT, EXTRA, COLUMN_COMMENT
+                FROM information_schema.columns
+                WHERE table_schema = DATABASE() AND table_name = 'commands' AND column_name = 'command'
+                """); var column = query.executeQuery()) {
+            if (!column.next()) throw new SQLException("Missing commands.command column");
+            type = column.getString(1); charset = column.getString(2); collation = column.getString(3);
+            nullable = column.getString(4); defaultValue = column.getString(5);
+            extra = column.getString(6); comment = column.getString(7);
+        }
+        // Never narrow a database which already has sufficient text capacity.
+        if ("mediumtext".equals(type) || "longtext".equals(type)) return;
+        // Widen the known legacy schema without guessing custom column semantics.
+        if (!("varchar".equals(type) || "text".equals(type)) || !"NO".equals(nullable)
+                || defaultValue != null || !"".equals(extra) || !"".equals(comment)
+                || charset == null || !charset.matches("[A-Za-z0-9_]+")
+                || collation == null || !collation.matches("[A-Za-z0-9_]+")) {
+            throw new SQLException("Unsupported commands.command schema; review its text capacity and attributes before logging");
+        }
+        try (var migration = connection.createStatement()) {
+            migration.execute("ALTER TABLE commands MODIFY COLUMN command MEDIUMTEXT CHARACTER SET "
+                    + charset + " COLLATE " + collation + " NOT NULL");
+        }
