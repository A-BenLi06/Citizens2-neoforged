--- /dev/null
+++ b/common/src/main/java/com/daqem/grieflogger/database/queue/QueuedStatement.java
@@ -0,0 +1,46 @@
+package com.daqem.grieflogger.database.queue;
+
+import java.sql.*;
+import java.util.*;
+
+/** SQL and owned parameter values; no open JDBC resource waits in the native queue. */
+public final class QueuedStatement {
+    private record Parameter(int index, int type, Object value) { }
+    private final String sql;
+    private final Map<Integer, Parameter> parameters = new TreeMap<>();
+    private final List<List<Parameter>> batches = new ArrayList<>();
+    private boolean frozen;
+
+    public QueuedStatement(String sql) { this.sql = Objects.requireNonNull(sql); }
+    private void set(int index, int type, Object value) throws SQLException {
+        if (frozen || index < 1) throw new SQLException("Queued statement is frozen or parameter index is invalid");
+        parameters.put(index, new Parameter(index, type, value));
+    }
+    public void setString(int index, String value) throws SQLException { set(index, Types.VARCHAR, value); }
+    public void setLong(int index, long value) throws SQLException { set(index, Types.BIGINT, value); }
+    public void setInt(int index, int value) throws SQLException { set(index, Types.INTEGER, value); }
+    public void setBytes(int index, byte[] value) throws SQLException { set(index, Types.VARBINARY, value == null ? null : value.clone()); }
+    public void addBatch() throws SQLException {
+        if (frozen) throw new SQLException("Queued statement is frozen");
+        batches.add(List.copyOf(parameters.values()));
+    }
+    public QueuedWrite freeze(boolean batch) {
+        if (frozen) throw new IllegalStateException("Statement is already queued");
+        frozen = true;
+        var rows = batch ? List.copyOf(batches) : List.of(List.copyOf(parameters.values()));
+        return connection -> {
+            if (rows.isEmpty()) return;
+            try (var statement = connection.prepareStatement(sql)) {
+                for (var row : rows) {
+                    statement.clearParameters();
+                    for (var parameter : row) {
+                        if (parameter.value() == null) statement.setNull(parameter.index(), parameter.type());
+                        else statement.setObject(parameter.index(), parameter.value(), parameter.type());
+                    }
+                    if (batch) statement.addBatch(); else statement.executeUpdate();
+                }
+                if (batch) statement.executeBatch();
+            }
+        };
+    }
+}
diff --git a/common/src/main/java/com/daqem/grieflogger/database/queue/QueuedWrite.java b/common/src/main/java/com/daqem/grieflogger/database/queue/QueuedWrite.java
new file mode 100644
index 0000000..f4617b1
--- /dev/null
+++ b/common/src/main/java/com/daqem/grieflogger/database/queue/QueuedWrite.java
@@ -0,0 +1,24 @@
+package com.daqem.grieflogger.database.queue;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.SQLException;
+
+/** One retained write that can recreate its driver state after a rolled-back attempt. */
+public interface QueuedWrite {
+    void execute(Connection connection) throws SQLException;
+    default boolean canRetryAfterFailure() { return true; }
+    default void closeAfterCommit() throws SQLException { }
+
+    static QueuedWrite legacy(PreparedStatement statement, boolean batch) {
+        java.util.Objects.requireNonNull(statement);
+        return new QueuedWrite() {
+            public void execute(Connection connection) throws SQLException {
+                if (batch) statement.executeBatch(); else statement.executeUpdate();
+            }
+            // JDBC drivers may discard their batch parameters even when execution fails.
+            public boolean canRetryAfterFailure() { return !batch; }
+            public void closeAfterCommit() throws SQLException { statement.close(); }
+        };
+    }
+}
